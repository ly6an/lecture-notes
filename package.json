{
  "name": "lecture-code",
  "version": "1.0.0",
  "description": "Code capture and formatting tool for lecture notes",
  "main": "main.js",
 "scripts": {
  "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
  "build": "vite build",
  "start": "electron .",
  "dist": "npm run build && electron-builder --win"
},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@babel/types": "^7.18.2",
    "concurrently": "^10.0.4",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "codemirror": "^6.0.2",
    "debug": "^4.4.3",
    "env-paths": "^3.0.0",
    "graceful-fs": "^4.2.11",
    "html-to-image": "^1.11.13",
    "ms": "^2.1.3",
    "progress": "^2.0.3",
    "semver": "^7.8.5",
    "shiki": "^4.4.3",
    "sumchecker": "^3.0.1",
    "tesseract.js": "^7.0.0",
    "undici": "^7.29.0",
    "undici-types": "^7.18.2"
  },

  "build": {
  "appId": "com.lecturecode.app",
  "productName": "LectureCode",
  "asar": true,
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "main.js",
    "preload.js",
    "package.json"
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
}
